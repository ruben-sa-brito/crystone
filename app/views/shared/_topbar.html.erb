<div class="topbar">
    <div class="date">
    <%
    mounths = {
        1 => "janeiro",
        2 => "fevereiro",
        3 => "março",
        4 => "abril",
        5 => "maio",
        6 => "junho",
        7 => "julho",
        8 => "agosto",
        9 => "setembro",
        10 => "outubro",
        11 => "novembro",
        12 => "dezembro"
    }
    %>

    <%= Date.current.day %> de <%= mounths[Date.current.month] %> de <%= Date.current.year %> 
    </div> 
    <i class="ti ti-bell"></i>
    <div class="user-icon">
        <i class="ti ti-user"> </i>
    </div>
</div>