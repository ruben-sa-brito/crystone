<dialog id="modal">
<div class="modal">
   <div class="modal-title">
      <div>Novo serviço</div>
      <button type="button" class="button-close" onclick="document.querySelector('#modal').close()">
         
      </button>
   </div>
   <div>
   <form class="flex flex-col gap-4">
    <input
        type="text"
        placeholder="Descrição"
        class="w-full rounded-md border border-gray-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
    >

    <input
        type="number"
        placeholder="Valor"
        class="w-full rounded-md border border-gray-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
    >

    <div class="flex justify-end gap-2">
        <button
            type="button"
            onclick="document.querySelector('#modal').close()"
            class="rounded-md border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-100"
        >
            Cancelar
        </button>

        <button
            type="submit"
            class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700"
        >
            Cadastrar
        </button>
    </div>
</form>
   </div>
</div>
</dialog>