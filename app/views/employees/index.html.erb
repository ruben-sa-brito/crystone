<%= render "shared/modal", id: "modal", title: "Novo Funcionário" do %>
<%= turbo_frame_tag "employee_modal" do %>
  <%= form_with url: employees_path, method: :post, class: "w-100" do |form| %>
    <% if @user&.errors&.any? %>
  <div class="form-errors">
    <% @user.errors.full_messages.each do |error| %>
      <p><%= error %></p>
    <% end %>
  </div>
<% end %>
    <div class="flex flex-column w-80 gap-10 text-lg mt-7"> 
        <div class="flex flex-column">
            <label for="name">Nome</label> 
            <input type="text" id="name" name="name" placeholder="Nome do funcionário"> 
        </div>
        <div class="flex flex-column">
            <label for="email">E-mail</label> 
            <input type="email" id="email" name="email" placeholder="exemplo@gmail.com"> 
        </div>
        <div class="flex flex-column">
        <label for="password">Senha</label> 
        <input type="password" id="password" name="password" placeholder="Senha"> 
        </div>
        <div class="flex flex-column">
        <label for="password_confirmation">Confirmar senha</label> 
        <input type="password" id="password_confirmation" name="password_confirmation" placeholder="Confirme sua Senha">
        </div>
    </div> 
    <div class="mt-7"> 
        <button class="button-blue" type="submit">Cadastrar</button> 
        <button class="button-red" type="button" onclick="this.closest('dialog').close()">Cancelar</button> 
    </div> 
   <% end %>
    <% end %>
<% end %>